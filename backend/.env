# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/haulsync_tms

# ── Auth ───────────────────────────────────────────────────────────────────────
# Use same JWT_SECRET as HaulSync core for SSO
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=5004
NODE_ENV=development
FRONTEND_URL=http://localhost:3004

# ── AI — BOL Reader ────────────────────────────────────────────────────────────
# OpenAI or any OpenAI-compatible endpoint
AI_API_KEY=sk-your-openai-api-key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o

# ── ELD Provider ───────────────────────────────────────────────────────────────
DEFAULT_ELD_PROVIDER=manual        # samsara | motive | omnitracs | geotab | peoplenet | bigroad | webhook | manual
SAMSARA_API_KEY=
MOTIVE_API_KEY=
OMNITRACS_API_KEY=
GEOTAB_DATABASE=
GEOTAB_USERNAME=
GEOTAB_PASSWORD=

# ── Maps & Routing ─────────────────────────────────────────────────────────────
MAPS_PROVIDER=here                 # google | here | mapbox | osrm
GOOGLE_MAPS_API_KEY=
HERE_API_KEY=
MAPBOX_TOKEN=

# ── HOS Engine thresholds ──────────────────────────────────────────────────────
HOS_WARNING_BUFFER_MINUTES=45     # Alert when this close to limit
HOS_BREAK_THRESHOLD_HOURS=8       # Continuous driving before break required
HOS_WEEKLY_WARNING_HOURS=10       # Hours before weekly cap to warn

# ── Matching Engine weights (must sum to 100) ─────────────────────────────────
MATCH_WEIGHT_DISTANCE=30
MATCH_WEIGHT_HOS=25
MATCH_WEIGHT_EQUIPMENT=25
MATCH_WEIGHT_BACKHAUL=20
MATCH_BACKHAUL_RADIUS_MILES=150

# ── HaulSync ecosystem integrations (optional) ────────────────────────────────
HAULSYNC_CORE_URL=http://localhost:5000
HAULSYNC_CORE_API_KEY=
HAULSYNC_CT_URL=http://localhost:5002
HAULSYNC_CT_API_KEY=

# ── Notifications ──────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
